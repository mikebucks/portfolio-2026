# Copy this file to `.env.local` and fill in the values.

# Contact form (Web3Forms). Free access key from https://web3forms.com —
# tied to the inbox that receives submissions. Public by design (client-side),
# hence the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Analytics (Mixpanel). Project token from the Mixpanel dashboard:
# Settings → Project Settings → "Project Token". Public by design (it only lets
# a client SEND events, never read them), hence the NEXT_PUBLIC_ prefix. Until
# this is set, all tracking is a silent no-op — nothing loads, nothing sends.
NEXT_PUBLIC_MIXPANEL_TOKEN=
